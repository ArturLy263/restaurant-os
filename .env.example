POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change_me
POSTGRES_DB=restaurant_os
DATABASE_URL=postgresql+psycopg://restaurant:change_me@localhost:5433/restaurant_os
JWT_SECRET_KEY=change_me_to_a_random_secret
ADMIN_PASSWORD=change_me

# Optional. Tests default to DATABASE_URL with "_test" appended to the
# database name (e.g. restaurant_os_test). Must end with "_test".
# TEST_DATABASE_URL=postgresql+psycopg://restaurant:change_me@localhost:5433/restaurant_os_test

# Optional: outbox delivery worker (python -m app.workers.outbox_worker).
# Defaults shown; see README "Delivery worker".
# OUTBOX_WORKER_BATCH_SIZE=100
# OUTBOX_WORKER_POLL_INTERVAL_SECONDS=1.0
# OUTBOX_WORKER_RESTAURANT_ID=<restaurant UUID>  # unset means all restaurants
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_PUBLISH_TIMEOUT_SECONDS=30
# OUTBOX_RETENTION_DAYS=7
# OUTBOX_CLEANUP_BATCH_SIZE=1000

# Optional: station event streams (WebSocket); see README
# "Station event streams". Delivery runs inside ONE API process.
# OUTBOX_WEBSOCKET_DELIVERY=false
# WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
# WEBSOCKET_REAUTH_INTERVAL_SECONDS=30
# WEBSOCKET_QUEUE_SIZE=100
# WEBSOCKET_MAX_CONNECTIONS=500
