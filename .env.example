# Copy to .env and replace every placeholder. .env is never committed.
# The API refuses to start with a placeholder or weak secret (see
# backend/app/core/config.py and docs/security.md).

# "development" (default), "test" or "production". Production turns on the
# strict checks (32+ character JWT secret, strong database password, no
# wildcard CORS) and hides the API docs.
ENVIRONMENT=development

# PostgreSQL (docker-compose.yml). Choose a strong password and use the same
# one inside DATABASE_URL below.
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change_me
POSTGRES_DB=restaurant_os_demo
DATABASE_URL=postgresql+psycopg://restaurant:change_me@localhost:5433/restaurant_os_demo

# Token signing key: at least 24 random characters (32+ in production).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_secret

# Password of every demo account created by backend/seed_demo.py
# (minimum 8 characters, maximum 72 bytes, not a placeholder). The seed
# only writes to a database named <name>_dev or <name>_demo (lowercase
# letters, digits and underscores).
DEMO_PASSWORD=

# Optional. Tests default to DATABASE_URL with "_test" appended to the
# database name (e.g. restaurant_os_demo_test). Must end with "_test".
# TEST_DATABASE_URL=postgresql+psycopg://restaurant:change_me@localhost:5433/restaurant_os_demo_test

# Optional: sign-in throttling (defaults shown). Failures are counted per
# email and per client address; blocks double from the base up to the max.
# LOGIN_THROTTLE_ENABLED=true
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=50
# LOGIN_WINDOW_SECONDS=900
# LOGIN_BLOCK_BASE_SECONDS=30
# LOGIN_BLOCK_MAX_SECONDS=900

# Optional: HTTP hardening (defaults shown). HSTS only behind HTTPS; CORS
# origins only when the frontend is served from another origin, e.g.
# CORS_ALLOWED_ORIGINS=["https://pos.example.com"]
# API_DOCS_ENABLED=            # unset: on outside production, off in production
# MAX_REQUEST_BODY_BYTES=1048576
# HSTS_MAX_AGE_SECONDS=0
# CORS_ALLOWED_ORIGINS=[]

# Optional: outbox delivery worker (python -m app.workers.outbox_worker).
# Defaults shown; see README "Delivery worker".
# OUTBOX_WORKER_BATCH_SIZE=100
# OUTBOX_WORKER_POLL_INTERVAL_SECONDS=1.0
# OUTBOX_WORKER_RESTAURANT_ID=<restaurant UUID>  # unset means all restaurants
# OUTBOX_MAX_ATTEMPTS=10
# OUTBOX_PUBLISH_TIMEOUT_SECONDS=30
# OUTBOX_RETENTION_DAYS=7
# OUTBOX_CLEANUP_BATCH_SIZE=1000

# Optional: station event streams (WebSocket); see README
# "Station event streams". Delivery runs inside ONE API process.
# OUTBOX_WEBSOCKET_DELIVERY=false
# WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
# WEBSOCKET_REAUTH_INTERVAL_SECONDS=30
# WEBSOCKET_QUEUE_SIZE=100
# WEBSOCKET_MAX_CONNECTIONS=500
